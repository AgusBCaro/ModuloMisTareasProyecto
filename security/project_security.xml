<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Grupo de Seguridad: Solo Mis Tareas -->
        <record id="group_project_only_my_tasks" model="res.groups">
            <field name="name">Proyectos: Solo Mis Tareas</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="comment">Usuarios con la restricción activa para visualizar únicamente sus tareas asignadas.</field>
        </record>

        <!-- Regla de Registro (Record Rule) vinculada al Grupo de Seguridad -->
        <record id="rule_project_task_only_my_tasks" model="ir.rule">
            <field name="name">Regla de Proyectos: Filtrar Solo Mis Tareas</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="groups" eval="[(4, ref('group_project_only_my_tasks'))]"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
