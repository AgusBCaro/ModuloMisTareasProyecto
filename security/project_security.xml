<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Grupo de Seguridad: Solo Mis Tareas -->
        <record id="group_project_only_my_tasks" model="res.groups">
            <field name="name">Proyectos: Solo Mis Tareas</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="comment">Usuarios con la restricción activa: oculta todas las vistas y menús de proyectos excepto 'Mis Tareas'.</field>
        </record>

        <!-- Regla de Registro sobre Tareas (project.task) -->
        <record id="rule_project_task_only_my_tasks" model="ir.rule">
            <field name="name">Regla de Tareas: Filtrar Solo Mis Tareas</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="groups" eval="[(4, ref('group_project_only_my_tasks'))]"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Regla de Registro sobre Proyectos (project.project): Ocultar 100% de proyectos -->
        <record id="rule_project_project_only_my_tasks" model="ir.rule">
            <field name="name">Regla de Proyectos: Ocultar Todos los Proyectos</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="groups" eval="[(4, ref('group_project_only_my_tasks'))]"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
